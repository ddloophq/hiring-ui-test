{
  "name": "hire-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "biome check . && tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "bun prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset && bun prisma/seed.ts",
    "dev": "next dev",
    "dev:inngest": "inngest-cli dev -u http://localhost:3000/api/inngest",
    "dev:all": "bun run --parallel dev dev:inngest",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "postinstall": "prisma generate",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-libsql": "7.10.1",
    "@prisma/client": "7.10.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.107.1",
    "@trpc/client": "^11.25.1",
    "@trpc/next": "^11.25.1",
    "@trpc/react-query": "^11.25.1",
    "@trpc/server": "^11.25.1",
    "inngest": "^4.26.2",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "superjson": "^2.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "inngest-cli": "^1.51.0",
    "postcss": "^8.5.32",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "inngest-cli"
  ]
}
